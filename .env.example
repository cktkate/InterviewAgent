# ============== LLM 配置 ==============
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=qwen-max
LLM_REQUEST_TIMEOUT_SECONDS=45

# Agent Harness budgets
AGENT_MAX_STEPS=30
AGENT_MAX_LLM_CALLS=12
AGENT_MAX_TOTAL_TOKENS=30000
AGENT_DEADLINE_SECONDS=120
AGENT_CONTEXT_MAX_CHARS=6000
AGENT_CONTEXT_MAX_TOKENS=1800
AGENT_CONTEXT_TOKENIZER_ENCODING=cl100k_base
RAG_QUERY_EXPANSION_ENABLED=false
RAG_METADATA_FILTER_ENABLED=true
EMBEDDING_MODEL=text-embedding-v3

# ============== 数据库配置 ==============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=interview_agent
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=interview_agent

# ============== Redis 配置 ==============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SHORT_TERM_TTL=86400
REDIS_RECONNECT_INITIAL_SECONDS=1
REDIS_RECONNECT_MAX_SECONDS=30
# memory for local development; redis for multi-instance deployments.
TOOL_RUNTIME_STATE_BACKEND=memory
TOOL_RUNTIME_REDIS_DB=3
TOOL_RUNTIME_STATE_PREFIX=iam:tool-runtime
TOOL_RUNTIME_IDEMPOTENCY_TTL_SECONDS=3600
# Legacy MySQL interview_checkpoints fallback; LangGraph is the default source.
SESSION_CHECKPOINT_ENABLED=false

# ============== Celery 异步任务 ==============
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============== Weaviate 配置 ==============
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
RAG_TOP_K=5
RAG_BM25_WEIGHT=0.4
RAG_VECTOR_WEIGHT=0.6
RAG_RETRIEVAL_TIMEOUT_SECONDS=8.0
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES_MULTIPLIER=3
RAG_ADAPTIVE_RERANK_ENABLED=true
RAG_ADAPTIVE_RERANK_THRESHOLD=0.90
RAG_RERANK_MAX_RETRIEVAL_LATENCY_MS=3000

# ============== MCP 工具配置 ==============
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# ============== 应用配置 ==============
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ============== 前端访问 ==============
PUBLIC_URL=http://your-server-ip:8000

# ============== 本地语音识别 ==============
# false：首次点击语音时再加载，API 启动更快；true：启动后在后台预热
STT_PRELOAD=false
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=zh
STT_MAX_AUDIO_BYTES=10485760
STT_TRANSCRIBE_TIMEOUT_SECONDS=90
STT_MAX_CONCURRENT_JOBS=2

# ============== Agent Runtime / Observability ==============
OBSERVABILITY_ENABLED=true
TRACE_JSONL_ENABLED=true
TRACE_JSONL_PATH=logs/agent_traces.jsonl
OTEL_SERVICE_NAME=interview-agent
# Optional: e.g. http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
# Celery Worker 独立进程指标端口；0 表示关闭 Worker 指标 HTTP 服务
METRICS_WORKER_PORT=9109
HEALTH_CHECK_TIMEOUT_SECONDS=2
READINESS_CACHE_SECONDS=5
LANGGRAPH_CHECKPOINT_ENABLED=true
# sqlite is for local development; use mysql for shared multi-instance deployment.
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite3
# Optional. Empty means reuse MYSQL_* above.
LANGGRAPH_CHECKPOINT_DATABASE_URL=

# ============== Celery / 跨进程任务事件 ==============
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=150
CELERY_TASK_TIME_LIMIT_SECONDS=180
TASK_EVENT_STREAM_ENABLED=true
TASK_EVENT_TRANSPORT=pubsub
TASK_EVENT_REDIS_DB=4
TASK_EVENT_STREAM_PREFIX=iam:task-events
TASK_EVENT_STREAM_MAXLEN=500
TASK_EVENT_STREAM_BLOCK_MS=1000

# ============== Authentication ==============
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=1440
